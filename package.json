{
  "name": "drop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "pnpm dlx vercel@64 build && pnpm dlx vercel@64 deploy --prebuilt",
    "deploy:netlify": "pnpm dlx netlify-cli@27 deploy --build",
    "deploy:cloudflare": "pnpm run build && pnpm dlx wrangler@4 pages deploy dist --project-name drop"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@videojs/core": "10.4.0",
    "@videojs/react": "10.4.0",
    "cn": "^0.4.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/mux-video": "10.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Drop: a shoppable streetwear skin for the Video.js v10 player.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0"
}
