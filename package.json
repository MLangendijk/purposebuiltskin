{
  "name": "atelier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "pnpm dlx vercel@64 build && pnpm dlx vercel@64 deploy --prebuilt",
    "deploy:netlify": "pnpm dlx netlify-cli@27 deploy --build",
    "deploy:cloudflare": "pnpm run build && pnpm dlx wrangler@4 pages deploy dist --project-name atelier"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@videojs/core": "10.4.0",
    "@videojs/react": "10.4.0",
    "cn": "^0.4.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/mux-data": "10.4.0",
    "@videojs/mux-video": "10.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.65.1",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Atelier: a shoppable fashion skin for the Video.js v10 player.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0"
}
